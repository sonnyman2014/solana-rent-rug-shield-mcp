#!/usr/bin/env python3
"""Local executable launcher for solana-rug-shield without global system install."""

import pathlib
import sys

_SRC = pathlib.Path(__file__).resolve().parents[1] / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from solana_rug_shield.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
